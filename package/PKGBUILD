#! /bin/bash

pkgname="archupdate"
install="recipes.sh"

pkgdesc="Keeps all precompiled and AUR software updated"
url="https://github.com/Imdabossou/ArchUpdate"
license=("GPL2")

# set pkgver with: date +%s
pkgver=1792883683
pkgrel=1
arch=("any")

source=("git+${url}")
b2sums=("SKIP")
backup=("usr/lib/systemd/system/archupdate.timer")


depends=(
	libnotify
	pacman-contrib
	sudo
	systemd
)

optdepends=(
	"yay: also update AUR packages"
)


package() {
	cp --recursive "${srcdir}/${pkgname}/root"/* "${pkgdir}"
	chmod 0750 "${pkgdir}/etc/sudoers.d"
	chmod 0440 "${pkgdir}/etc/sudoers.d/archupdate"
}
