#! /bin/bash
set -em
enable sleep

# For debugging (either "x" or empty):
verbose=
forcedUpdate=

# Other:
LANG="C.utf8"
databaseLock="/var/lib/pacman/db.lck"
keyringsLock="/var/lib/pacman/keys.lck"
aurUser="archupdate"


mainFunction () {
	if updatingIsFavorable && updatingIsNeeded; then
		if updatingArchupdateIsNeeded; then
			updateArchupdate
		fi

		updateKeyrings
		updateSystem
		updateAur
		waitFor pruneOldPackages
	fi

	terminateChildren
}


aurIsOutdated () {
	aurIsUsable &&
	commandAsUser "${aurUser}" yay --query --upgrades --aur &> /dev/null
}


aurIsUsable () {
	command -v yay &> /dev/null &&
	id "${aurUser}" &> /dev/null
}


archupdateIsOutdated () {
	local repoEpoch; repoEpoch="$(archupdateRepoEpoch)"
	local localEpoch; localEpoch="$(archupdateLocalEpoch)"

	! [[ "${localEpoch}" =~ : ]] &&
	[[ "${repoEpoch}" -gt "${localEpoch}" ]]
}


archupdateLocalEpoch () {
	pacman --query --info archupdate |
	grep "Version" |
	cut --delimiter=' ' --fields=11 |
	cut --delimiter='-' --fields=1
}


archupdateRepoEpoch () {
	curl --silent "https://raw.githubusercontent.com/Imdabossou/ArchUpdate/master/package/PKGBUILD" |
	grep "pkgver=" |
	cut --delimiter='=' --fields=2
}


batteryIsCharged () {
	local capacity="/sys/class/power_supply/BAT1/capacity"

	[[ ! -f "${capacity}" || "$(cat "${capacity}")" -ge 90 ]]
}


checkPermissions () {
	if [[ "${UID}" -ne 0 ]]; then
		sudo "${0}"
		exit "${?}"
	fi
}


commandAsUser () {
	local user="${1}"
	local command=("${@:2}")

	#shellcheck disable=SC2068,SC2086
	sudo -E -H -u ${user} ${command[@]}
}


connectionIsMetered () {
    nmcli --terse --fields GENERAL.METERED dev show 2>/dev/null |
    grep --quiet "yes"
}


deferInterruption () {
	printf "\n🕑 Interrupting when possible...\n"
	interrupted=true
}


downloadArchupdatePackageComponents () {
	local url="https://raw.githubusercontent.com/Imdabossou/ArchUpdate/master/package"

	curl --silent "${url}/PKGBUILD" > PKGBUILD
	curl --silent "${url}/recipes.sh" > recipes.sh
}


downloadPackage () {
	local package="${1}"

	so pacman --sync --noconfirm --downloadonly "${package}"
}


enterArchupdateBuildDir () {
	local dir="/tmp/archupdate"

	so rm --recursive --force "${dir}"
	so mkdir --parents "${dir}"
	so chown --recursive nobody "${dir}"
	cd "${dir}"
}


installPackage () {
	local package="${1}"

	so pacman --sync --noconfirm "${package}"
}


installAurUpdates () {
	waitLock
	so commandAsUser "${aurUser}" yay --sync --sysupgrade --aur --noconfirm \
		--answerclean None --answerdiff None --answeredit None \
		--removemake --cleanafter
}


installUpdates () {
	#shellcheck disable=SC2068
	so pacman --sync --sysupgrade --noconfirm ${@}
	refreshDatabases
}


keyrings () {
	local candidates; readarray -t candidates < <(packagesWithKeyword "query" "keyring")

	for candidate in "${candidates[@]}"; do
		if stringIsDate "$(packageVersion "query" "${candidate}")"; then
			echo "${candidate}"
		fi
	done
}


makePackage () {
	export PACKAGER="archupdate <@${HOSTNAME}>"
	so commandAsUser nobody makepkg --syncdeps --needed --rmdeps --force --noconfirm
}


ongoingInstallation () {
	if [[ -f "${databaseLock}" ]]; then
		local modified; modified="$(stat --format=%Y "${databaseLock}")"
		local booted; booted="$(date --date="$(who --boot | cut --delimiter=" " --fields=13-)" +%s)"

		if [[ $(( "${modified}" - "${booted}" )) -lt 0 ]] ||
		[[ $(( "$(date +%s)" - "${modified}" )) -gt 86400 ]]; then
			rm "${databaseLock}"
			false
		else
			true
		fi
	else
		false
	fi
}


packageInfo () {
	local operation="${1}"
	local package="${2}"
	local section="${3}"

	pacman --"${operation}" --info "${package}" |
	grep "^${section}" |
	cut --delimiter=':' --fields=2- |
	cut --delimiter=' ' --fields=2
}


packageIsOutdated () {
	local package="${1}"
	local localVersion; localVersion="$(packageVersion "query" "${package}")"
	local remoteVersion; remoteVersion="$(packageVersion "sync" "${package}")"

	[[ "${localVersion}" != "${remoteVersion}" ]]
}


packagesWithKeyword () {
	local operation="${1}"
	local keyword="${2}"

	pacman --"${operation}" --search "${keyword}" |
	grep --invert-match "^ " |
	cut --delimiter='/' --fields=2 |
	cut --delimiter=' ' --fields=1
}


packageVersion () {
	local operation="${1}"
	local package="${2}"

	packageInfo "${operation}" "${package}" "Version" |
	cut --delimiter='-' --fields=1
}


pruneOldPackages () {
	so paccache --remove --uninstalled --keep 0
	so paccache --remove --keep 2
}


refreshDatabases () {
	waitLock
	so pacman --sync --refresh
	so pacman --files --refresh
}


removeCurrentDir () {
	local dir="${PWD}"
	cd ".."
	so rm --recursive --force "${dir}"
}


setTrap () {
	local operation="${*}"
	trap '${operation}' ABRT ERR HUP INT QUIT TERM
}


so () {
	local commands=("${@}")

	if [[ -n "${verbose}" ]]; then
		#shellcheck disable=SC2068
		if ! ${commands[@]}; then
			exit "${?}"
		fi
	elif ! error="$(eval "${commands[*]}" 2>&1 >"/dev/null")" ; then
		if [[ "${error}" == "" ]] ; then
			error="Command failed: ${commands[*]}"
		fi

		echo "${FUNCNAME[1]}: ${error}" >&2
		false
	fi
}


stringIsDate () {
	local string="${*}"

	date +%s --date "${string}" &> /dev/null
}


systemIsOutdated () {
	refreshDatabases
	pacman --query --upgrades &> /dev/null
}


terminateChildren () {
	pkill -TERM -P $$ &>/dev/null || true
}


updateArchupdate () {
	enterArchupdateBuildDir
	downloadArchupdatePackageComponents
	makePackage
	waitFor updatePackagesHere
	removeCurrentDir
}


updateAur () {
	if aurIsOutdated; then
		waitFor installAurUpdates
	fi
}


updateKeyrings () {
	if [[ -f "${keyringsLock}" ]] || [[ ! -d "/etc/pacman.d/gnupg" ]] || ! updateKeyringsFromRepo; then
		updateKeyringsFromServer
	fi
}


updateKeyringsFromRepo () {
	local keyring
	local keyrings; readarray -t keyrings < <(keyrings)

	for keyring in "${keyrings[@]}"; do
		if packageIsOutdated "${keyring}"; then
			downloadPackage "${keyring}"
			waitForExits=false waitFor installPackage "${keyring}" 2>/dev/null
		fi
	done
}


updateKeyringsFromServer () {
	so touch "${keyringsLock}"

	so rm --recursive --force "/etc/pacman.d/gnupg"
	so pacman-key --init
	so pacman-key --populate
	so pacman-key --refresh-keys

	so rm "${keyringsLock}"
}


updatePackagesHere () {
	so pacman --upgrade --noconfirm ./*.pkg.*
	refreshDatabases
}


updateSystem () {
	installUpdates "--downloadonly"
	waitFor installUpdates
}


updatingArchupdateIsNeeded () {
	archupdateIsOutdated || [[ -n "${forcedUpdate}" ]]
}


updatingIsFavorable () {
	! ongoingInstallation && ! connectionIsMetered && batteryIsCharged
}


updatingIsNeeded () {
	systemIsOutdated || aurIsOutdated || [[ -n "${forcedUpdate}" ]]
}


waitFor () {
	local command=("${@}")

	if ! batteryIsCharged && [[ -z "${forcedUpdate}" ]]; then
		exit 0
	else
		interrupted=false
		trap 'deferInterruption' ABRT ERR HUP INT QUIT TERM
		#shellcheck disable=SC2068
		${command[@]} &

		while wait "$!"; status="$?"; [[ "${status}" -ge 128 ]]; do
			builtin sleep 0.1
		done

		if [[ "${status}" -ne 0 ]]; then
			if [[ -z "${waitForExits}" ]] || "${waitForExits}"; then
				exit "${status}"
			else
				false
			fi
		elif "${interrupted}"; then
			exit 130
		else
			trap - ABRT ERR HUP INT QUIT TERM
		fi
	fi
}


waitLock () {
	while [[ -f "${databaseLock}" ]]; do
		builtin sleep 0.1
	done
}


checkPermissions
mainFunction
