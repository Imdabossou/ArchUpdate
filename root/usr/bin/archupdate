#! /bin/bash
set -em
enable sleep

# For debugging (either "x" or empty):
verbose=
forcedUpdate=

# Desktop notifications while updating (either "x" or empty):
notifications=x

# Other:
LANG="C.utf8"
databaseLock="/var/lib/pacman/db.lck"
keyringsLock="/var/lib/pacman/keys.lck"
aurUser="archupdate"
declare -A notificationIds=()
updateStarted=false
updateFinished=false
systemPackages=()
aurPackages=()


mainFunction () {
	if updatingIsFavorable && updatingIsNeeded; then
		startUpdateSession

		if updatingArchupdateIsNeeded; then
			notifyProgress "Updating ArchUpdate itself"
			updateArchupdate
		fi

		notifyProgress "Checking signing keys"
		updateKeyrings
		updateSystem
		updateAur
		waitFor pruneOldPackages

		finishUpdateSession
	fi

	terminateChildren
}


aurIsOutdated () {
	aurIsUsable &&
	commandAsUser "${aurUser}" yay --query --upgrades --aur &> /dev/null
}


aurIsUsable () {
	command -v yay &> /dev/null &&
	id "${aurUser}" &> /dev/null
}


archupdateIsOutdated () {
	local repoEpoch; repoEpoch="$(archupdateRepoEpoch)"
	local localEpoch; localEpoch="$(archupdateLocalEpoch)"

	! [[ "${localEpoch}" =~ : ]] &&
	[[ "${repoEpoch}" -gt "${localEpoch}" ]]
}


archupdateLocalEpoch () {
	pacman --query --info archupdate |
	grep "Version" |
	cut --delimiter=' ' --fields=11 |
	cut --delimiter='-' --fields=1
}


archupdateRepoEpoch () {
	curl --silent "https://raw.githubusercontent.com/Imdabossou/ArchUpdate/main/package/PKGBUILD" |
	grep "pkgver=" |
	cut --delimiter='=' --fields=2
}


batteryIsCharged () {
	# Every system battery (BAT0, BAT1, ...) must be at 90% or more.
	# Batteries with scope "Device" belong to mice, headsets and the like, so they don't count.
	local supply capacity

	for supply in /sys/class/power_supply/*; do
		[[ "$(cat "${supply}/type" 2>/dev/null)" == "Battery" ]] || continue
		[[ "$(cat "${supply}/scope" 2>/dev/null)" == "Device" ]] && continue

		capacity="$(cat "${supply}/capacity" 2>/dev/null)"
		[[ "${capacity}" =~ ^[0-9]+$ ]] || continue

		if [[ "${capacity}" -lt 90 ]]; then
			return 1
		fi
	done
}


blockShutdown () {
	# Holds a logind inhibitor until this script exits, so shutting down
	# or suspending mid-install is refused. "tail --pid" ends with us, even
	# if we are killed, so the block can never outlive the update.
	command -v systemd-inhibit &> /dev/null || return 0

	systemd-inhibit --what=shutdown:sleep --mode=block \
		--who="ArchUpdate" --why="Installing system updates" \
		tail --pid=$$ --follow /dev/null &> /dev/null &
	disown
}


desktopUsers () {
	# UIDs that have a graphical session (Wayland or X11) right now.
	local session type uid line

	while read -r session _; do
		type=""; uid=""
		while IFS='=' read -r key line; do
			case "${key}" in
				Type) type="${line}" ;;
				User) uid="${line}" ;;
			esac
		done < <(loginctl show-session "${session}" --property=Type --property=User 2>/dev/null)

		if [[ "${type}" == "wayland" || "${type}" == "x11" ]] && [[ "${uid}" =~ ^[0-9]+$ ]]; then
			echo "${uid}"
		fi
	done < <(loginctl list-sessions --no-legend 2>/dev/null) | sort --unique
}


desktopNotify () {
	# desktopNotify <urgency> <timeout ms> <title> <body>
	# Replaces this run's earlier notification, so there's only ever one.
	# Never fails: a missing notification must not stop an update.
	[[ -n "${notifications}" ]] || return 0
	command -v notify-send &> /dev/null || return 0

	local urgency="${1}" timeout="${2}" title="${3}" body="${4}"
	local uid user id args

	for uid in $(desktopUsers); do
		[[ -S "/run/user/${uid}/bus" ]] || continue
		user="$(id --name --user "${uid}" 2>/dev/null)" || continue

		args=(--app-name="ArchUpdate" --icon="system-software-update"
			--urgency="${urgency}" --expire-time="${timeout}" --print-id)
		[[ -n "${notificationIds[${uid}]}" ]] && args+=(--replace-id="${notificationIds[${uid}]}")

		id="$(timeout 10 runuser --user="${user}" -- \
			env DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${uid}/bus" \
			notify-send "${args[@]}" -- "${title}" "${body}" 2>/dev/null)" || continue

		[[ "${id}" =~ ^[0-9]+$ ]] && notificationIds[${uid}]="${id}"
	done

	return 0
}


finishUpdateSession () {
	updateFinished=true

	local count=$(( ${#systemPackages[@]} + ${#aurPackages[@]} ))
	local body; body="$(packageSummary "${systemPackages[@]}" "${aurPackages[@]}")"

	if restartIsRecommended "${systemPackages[@]}"; then
		body+=$'\n'"Restart when convenient to use the new core system parts."
	fi

	desktopNotify normal 30000 "$(plural "${count}" update) installed" "${body}"
}


notifyFailure () {
	local status="${1}"

	if ! "${updateStarted}" || "${updateFinished}"; then
		return 0
	elif [[ "${status}" -eq 0 ]]; then
		# waitFor stops cleanly when the battery runs low.
		desktopNotify normal 30000 "Update paused" \
			"The battery is low. The rest installs on a later run."
	else
		desktopNotify critical 0 "Update stopped before finishing" \
			"Exit code ${status}. Details: journalctl -u archupdate"
	fi
}


notifyProgress () {
	local step="${1}"
	local count=$(( ${#systemPackages[@]} + ${#aurPackages[@]} ))

	desktopNotify normal 0 "Updating $(plural "${count}" package): don't shut down" \
		"${step}..."$'\n'"$(packageSummary "${systemPackages[@]}" "${aurPackages[@]}")"
}


plural () {
	# "1 package", "3 packages"
	if [[ "${1}" -eq 1 ]]; then echo "1 ${2}"; else echo "${1} ${2}s"; fi
}


packageSummary () {
	# "a, b, c, d, e and 9 more".
	local packages=("${@}")
	local shown=5
	local text

	if [[ "${#packages[@]}" -eq 0 ]]; then
		echo "No package list available"
		return
	fi

	text="$(IFS=','; echo "${packages[*]:0:${shown}}" | sed 's/,/, /g')"

	if [[ "${#packages[@]}" -gt "${shown}" ]]; then
		text+=" and $(( ${#packages[@]} - shown )) more"
	fi

	echo "${text}"
}


restartIsRecommended () {
	local package

	for package in "${@}"; do
		if [[ "${package}" =~ ^(linux(-lts|-zen|-hardened|-rt)?|systemd|glibc|mesa|nvidia.*|amd-ucode|intel-ucode|linux-firmware.*)$ ]]; then
			return 0
		fi
	done

	return 1
}


startUpdateSession () {
	updateStarted=true
	trap 'notifyFailure "${?}"' EXIT

	readarray -t systemPackages < <(pacman --query --upgrades --quiet 2>/dev/null)

	if aurIsUsable; then
		readarray -t aurPackages < <(commandAsUser "${aurUser}" yay --query --upgrades --aur --quiet 2>/dev/null)
	fi

	blockShutdown
	notifyProgress "Starting"
}


checkPermissions () {
	if [[ "${UID}" -ne 0 ]]; then
		sudo "${0}"
		exit "${?}"
	fi
}


commandAsUser () {
	local user="${1}"
	local command=("${@:2}")

	#shellcheck disable=SC2068,SC2086
	sudo -E -H -u ${user} ${command[@]}
}


connectionIsMetered () {
    nmcli --terse --fields GENERAL.METERED dev show 2>/dev/null |
    grep --quiet "yes"
}


deferInterruption () {
	printf "\n🕑 Interrupting when possible...\n"
	interrupted=true
}


downloadArchupdatePackageComponents () {
	local url="https://raw.githubusercontent.com/Imdabossou/ArchUpdate/main/package"

	curl --silent "${url}/PKGBUILD" > PKGBUILD
	curl --silent "${url}/recipes.sh" > recipes.sh
}


downloadPackage () {
	local package="${1}"

	so pacman --sync --noconfirm --downloadonly "${package}"
}


enterArchupdateBuildDir () {
	local dir="/tmp/archupdate"

	so rm --recursive --force "${dir}"
	so mkdir --parents "${dir}"
	so chown --recursive nobody "${dir}"
	cd "${dir}"
}


installPackage () {
	local package="${1}"

	so pacman --sync --noconfirm "${package}"
}


installAurUpdates () {
	waitLock
	so commandAsUser "${aurUser}" yay --sync --sysupgrade --aur --noconfirm \
		--answerclean None --answerdiff None --answeredit None \
		--removemake --cleanafter
}


installUpdates () {
	#shellcheck disable=SC2068
	so pacman --sync --sysupgrade --noconfirm ${@}
	refreshDatabases
}


keyrings () {
	local candidates; readarray -t candidates < <(packagesWithKeyword "query" "keyring")

	for candidate in "${candidates[@]}"; do
		if stringIsDate "$(packageVersion "query" "${candidate}")"; then
			echo "${candidate}"
		fi
	done
}


makePackage () {
	export PACKAGER="archupdate <@${HOSTNAME}>"
	so commandAsUser nobody makepkg --syncdeps --needed --rmdeps --force --noconfirm
}


ongoingInstallation () {
	if [[ -f "${databaseLock}" ]]; then
		local modified; modified="$(stat --format=%Y "${databaseLock}")"
		local booted; booted="$(date --date="$(who --boot | cut --delimiter=" " --fields=13-)" +%s)"

		if [[ $(( "${modified}" - "${booted}" )) -lt 0 ]] ||
		[[ $(( "$(date +%s)" - "${modified}" )) -gt 86400 ]]; then
			rm "${databaseLock}"
			false
		else
			true
		fi
	else
		false
	fi
}


packageInfo () {
	local operation="${1}"
	local package="${2}"
	local section="${3}"

	pacman --"${operation}" --info "${package}" |
	grep "^${section}" |
	cut --delimiter=':' --fields=2- |
	cut --delimiter=' ' --fields=2
}


packageIsOutdated () {
	local package="${1}"
	local localVersion; localVersion="$(packageVersion "query" "${package}")"
	local remoteVersion; remoteVersion="$(packageVersion "sync" "${package}")"

	[[ "${localVersion}" != "${remoteVersion}" ]]
}


packagesWithKeyword () {
	local operation="${1}"
	local keyword="${2}"

	pacman --"${operation}" --search "${keyword}" |
	grep --invert-match "^ " |
	cut --delimiter='/' --fields=2 |
	cut --delimiter=' ' --fields=1
}


packageVersion () {
	local operation="${1}"
	local package="${2}"

	packageInfo "${operation}" "${package}" "Version" |
	cut --delimiter='-' --fields=1
}


pruneOldPackages () {
	so paccache --remove --uninstalled --keep 0
	so paccache --remove --keep 2
}


refreshDatabases () {
	waitLock
	so pacman --sync --refresh
	so pacman --files --refresh
}


removeCurrentDir () {
	local dir="${PWD}"
	cd ".."
	so rm --recursive --force "${dir}"
}


setTrap () {
	local operation="${*}"
	trap '${operation}' ABRT ERR HUP INT QUIT TERM
}


so () {
	local commands=("${@}")

	if [[ -n "${verbose}" ]]; then
		#shellcheck disable=SC2068
		if ! ${commands[@]}; then
			exit "${?}"
		fi
	elif ! error="$(eval "${commands[*]}" 2>&1 >"/dev/null")" ; then
		if [[ "${error}" == "" ]] ; then
			error="Command failed: ${commands[*]}"
		fi

		echo "${FUNCNAME[1]}: ${error}" >&2
		false
	fi
}


stringIsDate () {
	local string="${*}"

	date +%s --date "${string}" &> /dev/null
}


systemIsOutdated () {
	refreshDatabases
	pacman --query --upgrades &> /dev/null
}


terminateChildren () {
	pkill -TERM -P $$ &>/dev/null || true
}


updateArchupdate () {
	enterArchupdateBuildDir
	downloadArchupdatePackageComponents
	makePackage
	waitFor updatePackagesHere
	removeCurrentDir
}


updateAur () {
	if aurIsOutdated; then
		notifyProgress "Building and installing AUR packages"
		waitFor installAurUpdates
	fi
}


updateKeyrings () {
	if [[ -f "${keyringsLock}" ]] || [[ ! -d "/etc/pacman.d/gnupg" ]] || ! updateKeyringsFromRepo; then
		updateKeyringsFromServer
	fi
}


updateKeyringsFromRepo () {
	local keyring
	local keyrings; readarray -t keyrings < <(keyrings)

	for keyring in "${keyrings[@]}"; do
		if packageIsOutdated "${keyring}"; then
			downloadPackage "${keyring}"
			waitForExits=false waitFor installPackage "${keyring}" 2>/dev/null
		fi
	done
}


updateKeyringsFromServer () {
	so touch "${keyringsLock}"

	so rm --recursive --force "/etc/pacman.d/gnupg"
	so pacman-key --init
	so pacman-key --populate
	so pacman-key --refresh-keys

	so rm "${keyringsLock}"
}


updatePackagesHere () {
	so pacman --upgrade --noconfirm ./*.pkg.*
	refreshDatabases
}


updateSystem () {
	notifyProgress "Downloading"
	installUpdates "--downloadonly"
	notifyProgress "Installing"
	waitFor installUpdates
}


updatingArchupdateIsNeeded () {
	archupdateIsOutdated || [[ -n "${forcedUpdate}" ]]
}


updatingIsFavorable () {
	! ongoingInstallation && ! connectionIsMetered && batteryIsCharged
}


updatingIsNeeded () {
	systemIsOutdated || aurIsOutdated || [[ -n "${forcedUpdate}" ]]
}


waitFor () {
	local command=("${@}")

	if ! batteryIsCharged && [[ -z "${forcedUpdate}" ]]; then
		exit 0
	else
		interrupted=false
		trap 'deferInterruption' ABRT ERR HUP INT QUIT TERM
		#shellcheck disable=SC2068
		${command[@]} &

		while wait "$!"; status="$?"; [[ "${status}" -ge 128 ]]; do
			builtin sleep 0.1
		done

		if [[ "${status}" -ne 0 ]]; then
			if [[ -z "${waitForExits}" ]] || "${waitForExits}"; then
				exit "${status}"
			else
				false
			fi
		elif "${interrupted}"; then
			exit 130
		else
			trap - ABRT ERR HUP INT QUIT TERM
		fi
	fi
}


waitLock () {
	while [[ -f "${databaseLock}" ]]; do
		builtin sleep 0.1
	done
}


checkPermissions
mainFunction
